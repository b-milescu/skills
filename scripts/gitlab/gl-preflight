#!/usr/bin/env bash
# gl-preflight — verify glab + auth + current repo before running other gl-* wrappers.
# Exits non-zero with a clear message on the first failure.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'USAGE'
Usage: gl-preflight

Checks, in order:
  1. glab is on PATH
  2. cwd is inside a git working tree
  3. glab repo view succeeds against the inferred project
     (this is the real auth check — `glab auth status` is unreliable when
     multiple hosts are configured and only one is in use)

Exits 0 on success; prints a one-line failure and exits non-zero otherwise.
USAGE
  exit 0
fi

command -v glab >/dev/null 2>&1 || { echo "gl-preflight: glab not found on PATH" >&2; exit 1; }
git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "gl-preflight: cwd is not inside a git working tree" >&2; exit 1; }
glab repo view >/dev/null 2>&1 || { echo "gl-preflight: glab repo view failed for current project (auth or remote misconfig)" >&2; exit 1; }

echo "ok"
