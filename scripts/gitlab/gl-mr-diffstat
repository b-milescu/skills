#!/usr/bin/env bash
# gl-mr-diffstat — print a `git diff --stat` summary of an MR's diff.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -lt 1 ]]; then
  cat <<'USAGE'
Usage: gl-mr-diffstat <mr-id>

Fetches the MR's raw patch and pipes it through `git apply --stat`.
There is no `glab mr diff --stat`; this wrapper is the supported workaround.
USAGE
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && exit 0 || exit 2
fi

glab mr diff "$1" --raw --color=never | git apply --stat
