#!/usr/bin/env bash
# gl-mr-update-description — replace an MR's description with the contents of a file.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -lt 2 ]]; then
  cat <<'USAGE'
Usage: gl-mr-update-description <mr-id> <packet-file>

Wraps: glab mr update <mr-id> --description "$(cat <packet-file>)"
Overwrites the MR description. Use to refresh the Reviewer Lift block after pushes.
USAGE
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && exit 0 || exit 2
fi

id="$1"
packet="$2"
[[ -f "$packet" ]] || { echo "gl-mr-update-description: packet file not found: $packet" >&2; exit 1; }

glab mr update "$id" --description "$(cat "$packet")"
