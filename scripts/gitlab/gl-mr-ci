#!/usr/bin/env bash
# gl-mr-ci — print the SHA / pipeline / merge-status triple for an MR.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -lt 1 ]]; then
  cat <<'USAGE'
Usage: gl-mr-ci <mr-id>

Prints a JSON object: { mr_sha, pipeline, merge } — enough to decide whether
the pipeline belongs to the head SHA and whether the MR is mergeable.

Requires glab + jq.
USAGE
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && exit 0 || exit 2
fi

command -v jq >/dev/null 2>&1 || { echo "gl-mr-ci: jq required" >&2; exit 1; }
glab mr view "$1" -F json | jq '{mr_sha:.sha, pipeline:.pipeline, merge:.detailed_merge_status}'
