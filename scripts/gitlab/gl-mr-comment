#!/usr/bin/env bash
# gl-mr-comment — post a top-level MR comment whose body comes from a file.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -lt 2 ]]; then
  cat <<'USAGE'
Usage: gl-mr-comment <mr-id> <message-file>

Wraps: glab mr note create <mr-id> --message "$(cat <message-file>)"
Use for Review Reports, Revision Packets, Stuck Packets, delta comments, etc.
USAGE
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && exit 0 || exit 2
fi

id="$1"
msg="$2"
[[ -f "$msg" ]] || { echo "gl-mr-comment: message file not found: $msg" >&2; exit 1; }

glab mr note "$id" --message "$(cat "$msg")"
