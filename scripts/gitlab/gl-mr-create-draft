#!/usr/bin/env bash
# gl-mr-create-draft — open a Draft MR with description loaded from a file.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -lt 4 ]]; then
  cat <<'USAGE'
Usage: gl-mr-create-draft <target-branch> <source-branch> <title> <packet-file>

Wraps:
  glab mr create --draft \
    --target-branch <target-branch> \
    --source-branch <source-branch> \
    --title <title> \
    --description "$(cat <packet-file>)"

The source branch must already exist on origin (push first, or use
`glab mr create --push` directly when you'd rather glab handle the push).
USAGE
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && exit 0 || exit 2
fi

target="$1"
source="$2"
title="$3"
packet="$4"

[[ -f "$packet" ]] || { echo "gl-mr-create-draft: packet file not found: $packet" >&2; exit 1; }

glab mr create --draft \
  --target-branch "$target" \
  --source-branch "$source" \
  --title "$title" \
  --description "$(cat "$packet")"
