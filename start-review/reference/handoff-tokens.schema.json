{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill://start-review/reference/handoff-tokens.schema.json",
  "kind": "reviewer-handoff-tokens-schema",
  "version": "1",
  "owner": "start-review",
  "human_resource": "skill://start-review/templates/filling-guide.md",
  "summary": "Canonical reviewer verdict, blocker and routing tokens; native outcome mappings are owned by the invoked target's confirmed integration.",
  "review_verdict": [
    "pass",
    "request-changes",
    "reject",
    "blocked"
  ],
  "action_blocker": [
    "none",
    "missing-authority",
    "changed-head-sha",
    "merge-conflict",
    "sha-bound-action-unsupported",
    "preflight-failure",
    "permission-failure",
    "human-decision-needed",
    "partial-review",
    "secret-exposure-suspected",
    "other"
  ],
  "next_action": [
    "finish-by-authorized-actor",
    "revise",
    "human-escalation",
    "rerun-review",
    "fix-blocker"
  ],
  "blocker_token": [
    "none",
    "missing-authority",
    "changed-head-sha",
    "merge-conflict",
    "sha-bound-action-unsupported",
    "preflight-failure",
    "permission-failure",
    "human-decision-needed",
    "partial-review",
    "secret-exposure-suspected",
    "other"
  ]
}
