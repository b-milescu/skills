{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill://gitlab-local/reference/mutation-guard.schema.json",
  "kind": "gitlab-mutation-guard-schema",
  "version": "1",
  "owner": "gitlab-local",
  "human_resource": "skill://gitlab-local/reference/mutation-guard.md",
  "summary": "Machine-readable contract for the GitLab Mutation Guard seam. Mutating GitLab workflow snippets use this ordered guard before one GitLab mutation and use its output shape after the post-mutation MCP re-read.",
  "cross_project_guidance": {
    "guard_docs": "skill://gitlab-local/reference/mutation-guard.md",
    "guard_schema": "skill://gitlab-local/reference/mutation-guard.schema.json",
    "guard_scripts": "skill://gitlab-local/scripts/",
    "target_repo_docs": "Use repo-relative docs/agents/... paths for the target repository's policy docs, not skill://gitlab-local/docs/agents/... aliases."
  },
  "ordered_steps": [
    {
      "order": 1,
      "id": "project_binding",
      "requires": ["project_path", "repo_url_or_project_id", "default_branch_when_relevant"],
      "blocks": ["project_binding_mismatch", "mcp_unavailable"],
      "output": "bound project path, host, repo URL, and default branch evidence"
    },
    {
      "order": 2,
      "id": "current_target_reread",
      "requires": ["single-record get_merge_request or get_issue read", "target_iid_or_url"],
      "blocks": ["target_reread_unavailable", "project_binding_mismatch", "mcp_pagination_gap"],
      "output": "current MR/issue state, MR head SHA when MR-bound, author/caller-relevant fields"
    },
    {
      "order": 3,
      "id": "reviewed_sha_guard",
      "requires": ["reviewed_sha when the mutation is review/ready/finish/SHA-bound"],
      "blocks": ["head_changed"],
      "output": "reviewed_sha_status is match or n/a; stale heads block before fallback"
    },
    {
      "order": 4,
      "id": "exact_sha_ci_guard",
      "requires": ["list_pipelines(sha=reviewed_sha) or get_pipeline when CI is relevant"],
      "blocks": ["stale_ci", "red_ci", "missing_ci"],
      "output": "pipeline id, URL, status, and SHA bound to reviewed_sha; n/a only when CI is not relevant"
    },
    {
      "order": 5,
      "id": "authority_verification",
      "requires": ["caller_role", "action", "authority value", "authority source"],
      "blocks": ["missing_authority", "authority_source_mismatch", "permission_uncertain"],
      "output": "authority verdict and source provenance for exactly one requested action"
    },
    {
      "order": 6,
      "id": "caller_identity_and_context",
      "requires": ["entry caller identity", "pre-mutation caller identity re-check", "context-firewall role"],
      "blocks": ["identity_unavailable", "identity_changed", "self_merge_risk"],
      "output": "stable caller identity evidence and role/context eligibility"
    },
    {
      "order": 7,
      "id": "safe_gitlab_text",
      "requires": ["content-byte guard for body-bearing mutations"],
      "blocks": ["content_byte_failure"],
      "output": "safe_text_status is pass or n/a; diagnostics never include body bytes"
    },
    {
      "order": 8,
      "id": "fallback_eligibility",
      "requires": ["mcp_gap_state", "help-first evidence for flagged glab fallback", "all prior guards passed"],
      "blocks": ["fallback_forbidden", "mcp_unavailable"],
      "output": "transport plan is mcp, glab-fallback, or no-action handoff"
    },
    {
      "order": 9,
      "id": "single_mutation",
      "requires": ["one mutation action", "SHA/confirm binding when supported by the transport"],
      "blocks": ["permission_uncertain", "mutation_failed"],
      "output": "one attempted mutation or no-action handoff; never combined approve+merge or create+ready"
    },
    {
      "order": 10,
      "id": "post_mutation_mcp_reread",
      "requires": ["fresh MCP re-read of the mutated target or canonical confirmation endpoint"],
      "blocks": ["post_reread_unavailable", "description_lost", "target_state_mismatch", "stale_head", "merge_blocked"],
      "output": "verified state classification plus via=mcp, via=glab-fallback, or via=n/a evidence"
    }
  ],
  "input_fields": [
    "mutation_kind",
    "snippet_name",
    "project_path",
    "repo_url",
    "target_iid_or_url",
    "source_branch",
    "target_branch",
    "reviewed_sha",
    "ci_policy",
    "authority_value",
    "authority_source",
    "caller_role",
    "caller_identity",
    "safe_text_role",
    "mcp_gap_state",
    "fallback_help_evidence",
    "expected_post_state"
  ],
  "output_fields": [
    "result",
    "blocker",
    "mutation_performed",
    "transport_evidence",
    "mcp_gap_state",
    "project_binding",
    "target_state",
    "reviewed_sha_status",
    "ci_guard",
    "authority_verification",
    "caller_identity_verification",
    "safe_text_status",
    "post_mutation_reread"
  ],
  "result_states": ["passed", "blocked", "handoff", "held", "escalated"],
  "blocker_states": [
    {"token": "none", "fallback_allowed": true, "meaning": "No blocker."},
    {"token": "project_binding_mismatch", "fallback_allowed": false, "meaning": "Current repo/project does not match the bound GitLab project."},
    {"token": "target_reread_unavailable", "fallback_allowed": false, "meaning": "Decision-grade current target re-read failed."},
    {"token": "head_changed", "fallback_allowed": false, "meaning": "MR head SHA differs from reviewed_sha before mutation."},
    {"token": "stale_head", "fallback_allowed": false, "meaning": "Post-mutation re-read shows a different head than the guarded SHA."},
    {"token": "stale_ci", "fallback_allowed": false, "meaning": "Pipeline evidence is for a different SHA than reviewed_sha."},
    {"token": "red_ci", "fallback_allowed": false, "meaning": "Exact-SHA CI is failed, canceled, skipped, or otherwise non-pass."},
    {"token": "missing_ci", "fallback_allowed": false, "meaning": "Required exact-SHA CI evidence is missing."},
    {"token": "missing_authority", "fallback_allowed": false, "meaning": "Required approval/merge/ready/note authority or source is absent."},
    {"token": "authority_source_mismatch", "fallback_allowed": false, "meaning": "Declared authority source does not match the freshly verified source."},
    {"token": "permission_uncertain", "fallback_allowed": false, "meaning": "The actor's permission to take the action is unknown or contradicted."},
    {"token": "identity_unavailable", "fallback_allowed": false, "meaning": "Authenticated GitLab caller identity could not be resolved."},
    {"token": "identity_changed", "fallback_allowed": false, "meaning": "Authenticated GitLab caller identity changed before mutation."},
    {"token": "self_merge_risk", "fallback_allowed": false, "meaning": "Role/context firewall indicates the same builder/reviser/session would finish its own work; GitLab account equality alone is not this blocker."},
    {"token": "content_byte_failure", "fallback_allowed": false, "meaning": "Safe GitLab Text content-byte guard rejected a body-bearing mutation."},
    {"token": "fallback_forbidden", "fallback_allowed": false, "meaning": "A fallback was requested when the guard permits only MCP or no action."},
    {"token": "mutation_failed", "fallback_allowed": false, "meaning": "The selected mutation failed after all guards passed."},
    {"token": "post_reread_unavailable", "fallback_allowed": false, "meaning": "The required post-mutation MCP re-read could not confirm the result."},
    {"token": "description_lost", "fallback_allowed": false, "meaning": "Post-mutation re-read shows an emptied or lost MR description."},
    {"token": "target_state_mismatch", "fallback_allowed": false, "meaning": "Post-mutation re-read did not show the intended target state."},
    {"token": "merge_blocked", "fallback_allowed": false, "meaning": "Post-mutation re-read shows the MR is not mergeable/open and no merge result exists."}
  ],
  "mcp_gap_states": [
    {"token": "none", "fallback_allowed": false, "meaning": "No MCP gap; use MCP primary transport."},
    {"token": "mcp_unavailable", "fallback_allowed": true, "meaning": "MCP tool/read is unavailable for the required action; fallback still requires all non-transport guards and post-mutation MCP re-read before success is trusted."},
    {"token": "mcp_merge_robustness_gap", "fallback_allowed": true, "meaning": "Documented merge_merge_request robustness/error-normalization gap after all SHA/CI/authority/identity guards passed."},
    {"token": "mcp_pagination_gap", "fallback_allowed": true, "meaning": "MCP list pagination is insufficient for exhaustive selection; fallback can only select candidates and single-record re-reads must decide before mutation."}
  ],
  "fallback_forbidden_when": [
    "project_binding_mismatch",
    "target_reread_unavailable",
    "head_changed",
    "stale_head",
    "stale_ci",
    "red_ci",
    "missing_ci",
    "missing_authority",
    "authority_source_mismatch",
    "permission_uncertain",
    "identity_unavailable",
    "identity_changed",
    "self_merge_risk",
    "content_byte_failure",
    "post_reread_unavailable",
    "description_lost",
    "target_state_mismatch",
    "merge_blocked"
  ],
  "transport_evidence": {
    "tokens": ["via=mcp", "via=glab-fallback", "via=n/a"],
    "rule": "Every report for a GitLab API mutation records via=mcp or via=glab-fallback. via=n/a is reserved for no-action handoff/held results."
  },
  "post_mutation_reread_classifications": [
    "verified",
    "note_created",
    "description_updated",
    "ready_marked",
    "approved",
    "merged",
    "auto_merge_queued",
    "labels_reconciled",
    "issue_updated",
    "already_merged",
    "stale_head",
    "merge_blocked",
    "description_lost",
    "target_state_mismatch",
    "post_reread_unavailable"
  ],
  "mutation_profiles": {
    "body_bearing": {
      "examples": ["draft-mr-create", "mr-description-update", "mr-note-create", "issue-note-create"],
      "required_steps": ["project_binding", "current_target_reread", "authority_verification", "caller_identity_and_context", "safe_gitlab_text", "fallback_eligibility", "single_mutation", "post_mutation_mcp_reread"]
    },
    "sha_bound_finish": {
      "examples": ["sha-bound-approval", "sha-bound-merge", "sha-bound-auto-merge-queue", "finish-mr-authority-aware"],
      "required_steps": ["project_binding", "current_target_reread", "reviewed_sha_guard", "exact_sha_ci_guard", "authority_verification", "caller_identity_and_context", "fallback_eligibility", "single_mutation", "post_mutation_mcp_reread"]
    },
    "ready_transition": {
      "examples": ["draft-mr-mark-ready"],
      "required_steps": ["project_binding", "current_target_reread", "reviewed_sha_guard", "exact_sha_ci_guard", "authority_verification", "caller_identity_and_context", "safe_gitlab_text", "fallback_eligibility", "single_mutation", "post_mutation_mcp_reread"]
    },
    "candidate_selection": {
      "examples": ["issue-pickup", "mr-pickup"],
      "required_steps": ["project_binding", "current_target_reread"]
    }
  },
  "examples": [
    {
      "label": "blocked: stale head",
      "mutation_kind": "sha-bound-merge",
      "mcp_gap_state": "none",
      "result": "blocked",
      "blocker": "head_changed",
      "transport_evidence": "via=n/a",
      "mutation_performed": false,
      "fallback_allowed": false,
      "post_mutation_reread": {"required": false, "classification": "n/a"}
    },
    {
      "label": "blocked: stale CI",
      "mutation_kind": "sha-bound-merge",
      "mcp_gap_state": "none",
      "result": "blocked",
      "blocker": "stale_ci",
      "transport_evidence": "via=n/a",
      "mutation_performed": false,
      "fallback_allowed": false,
      "post_mutation_reread": {"required": false, "classification": "n/a"}
    },
    {
      "label": "blocked: red CI",
      "mutation_kind": "sha-bound-merge",
      "mcp_gap_state": "none",
      "result": "blocked",
      "blocker": "red_ci",
      "transport_evidence": "via=n/a",
      "mutation_performed": false,
      "fallback_allowed": false,
      "post_mutation_reread": {"required": false, "classification": "n/a"}
    },
    {
      "label": "blocked: missing authority",
      "mutation_kind": "sha-bound-approval",
      "mcp_gap_state": "none",
      "result": "blocked",
      "blocker": "missing_authority",
      "transport_evidence": "via=n/a",
      "mutation_performed": false,
      "fallback_allowed": false,
      "post_mutation_reread": {"required": false, "classification": "n/a"}
    },
    {
      "label": "blocked: self-merge risk",
      "mutation_kind": "finish-mr-authority-aware",
      "mcp_gap_state": "none",
      "result": "blocked",
      "blocker": "self_merge_risk",
      "transport_evidence": "via=n/a",
      "mutation_performed": false,
      "fallback_allowed": false,
      "post_mutation_reread": {"required": false, "classification": "n/a"}
    },
    {
      "label": "fallback: MCP merge robustness gap verified",
      "mutation_kind": "sha-bound-merge",
      "mcp_gap_state": "mcp_merge_robustness_gap",
      "result": "passed",
      "blocker": "none",
      "transport_evidence": "via=glab-fallback",
      "mutation_performed": true,
      "fallback_allowed": true,
      "post_mutation_reread": {"required": true, "classification": "verified"}
    },
    {
      "label": "success: post-mutation reread verified",
      "mutation_kind": "mr-note-create",
      "mcp_gap_state": "none",
      "result": "passed",
      "blocker": "none",
      "transport_evidence": "via=mcp",
      "mutation_performed": true,
      "fallback_allowed": false,
      "post_mutation_reread": {"required": true, "classification": "note_created"}
    },
    {
      "label": "blocked: content byte failure",
      "mutation_kind": "mr-description-update",
      "mcp_gap_state": "none",
      "result": "blocked",
      "blocker": "content_byte_failure",
      "transport_evidence": "via=n/a",
      "mutation_performed": false,
      "fallback_allowed": false,
      "post_mutation_reread": {"required": false, "classification": "n/a"}
    }
  ]
}
