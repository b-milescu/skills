{
  "name": "@agents/omp-mr-router",
  "version": "0.1.0",
  "private": true,
  "description": "Oh My Pi MR delivery router for role-based model routing.",
  "type": "module",
  "main": "src/router.mjs",
  "exports": {
    ".": "./src/router.mjs",
    "./extension": "./src/extension.mjs"
  },
  "bin": {
    "omp-mr-router": "./bin/omp-mr-router.mjs"
  },
  "files": [
    "agents/pi/*.md",
    "bin/omp-mr-router.mjs",
    "src/*.mjs"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "omp": {
    "extensions": [
      "src/extension.mjs"
    ],
    "agents": [
      "agents/pi"
    ]
  },
  "pi": {
    "extensions": [
      "src/extension.mjs"
    ],
    "agents": [
      "agents/pi"
    ]
  }
}
