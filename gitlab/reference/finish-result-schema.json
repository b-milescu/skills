{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gitlab/reference/finish-result-schema.json",
  "title": "finish_result",
  "description": "Machine-readable result the agent-driven finish flow emits and the parent orchestrator gates on. It records Authority Verification evidence (gitlab/reference/authority-verification.md) separately from transport evidence, so reports can distinguish verified authority from via=mcp / via=glab-fallback mutation transport without trusting prose-only summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "action",
    "transport",
    "sha",
    "blocker",
    "issue_state",
    "worktree_cleanup",
    "branch_cleanup",
    "authority_verification_source",
    "caller_user_id_verification_source",
    "cleanup_verified",
    "cleanup_failure_reason",
    "override_recorded",
    "conflict_type",
    "retry_count"
  ],
  "properties": {
    "result": {
      "description": "Terminal outcome class of the finish attempt.",
      "type": "string",
      "enum": [
        "merged",
        "auto_merge_queued",
        "handoff",
        "held",
        "escalated"
      ]
    },
    "action": {
      "description": "Finish action actually taken (or none for handoff/held/escalated).",
      "type": "string",
      "enum": [
        "approve",
        "merge",
        "auto_merge",
        "none"
      ]
    },
    "transport": {
      "description": "GitLab transport that performed the finish action or produced the handoff. Report this as via=mcp or via=glab-fallback in human summaries; n/a is only for no-action handoff/held results before any transport action.",
      "type": "string",
      "enum": [
        "mcp",
        "glab-fallback",
        "n/a"
      ]
    },
    "sha": {
      "description": "Reviewed/merged commit SHA the finish attempt was bound to. 40-char lowercase hex, or empty string when no SHA was bound (e.g. an early mcp_unavailable hold).",
      "type": "string",
      "pattern": "^([0-9a-f]{40})?$"
    },
    "blocker": {
      "description": "Why the finish could not complete the merge (none when it did).",
      "type": "string",
      "enum": [
        "none",
        "mcp_unavailable",
        "identity_unavailable",
        "identity_changed",
        "authority",
        "head_changed",
        "not_mergeable",
        "description_lost",
        "cleanup_failed"
      ]
    },
    "ci": {
      "description": "Optional nullable advisory pipeline observation for reviewed_sha. Null means no reviewed-SHA pipeline; absent is allowed only on an already-merged no-mutation short circuit.",
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "issue_state": {
      "description": "Observed state of the closing issue after the finish attempt.",
      "type": "string",
      "enum": [
        "closed",
        "closure_pending",
        "n/a"
      ]
    },
    "worktree_cleanup": {
      "description": "State of local worktree cleanup.",
      "type": "string",
      "enum": [
        "done",
        "pending",
        "n/a"
      ]
    },
    "branch_cleanup": {
      "description": "State of source-branch cleanup.",
      "type": "string",
      "enum": [
        "done",
        "pending",
        "retained_by_policy"
      ]
    },
    "authority_verification_source": {
      "description": "How merge authority was verified for this finish through the canonical Authority Verification seam (gitlab/reference/authority-verification.md). This is separate from the transport field.",
      "type": "string",
      "enum": [
        "description-verified",
        "description-mismatch",
        "parameter-assumed",
        "parameter-verified"
      ]
    },
    "caller_user_id_verification_source": {
      "description": "How the caller user id (for audit/token-stability) was obtained.",
      "type": "string",
      "enum": [
        "fresh-call",
        "cached",
        "unknown"
      ]
    },
    "cleanup_verified": {
      "description": "Whether local cleanup was verified. Tri-state: true, false, or the string \"pending\".",
      "type": [
        "boolean",
        "string"
      ],
      "enum": [
        true,
        false,
        "pending"
      ]
    },
    "cleanup_failure_reason": {
      "description": "Why cleanup failed (none when it did not).",
      "type": "string",
      "enum": [
        "none",
        "dirty_worktree",
        "git_error",
        "other"
      ]
    },
    "override_recorded": {
      "description": "Whether a documented human/authority override was recorded for this finish.",
      "type": "boolean"
    },
    "conflict_type": {
      "description": "Merge-time conflict classification.",
      "type": "string",
      "enum": [
        "none",
        "already_merged",
        "stale_head",
        "merge_blocked"
      ]
    },
    "retry_count": {
      "description": "Number of finish retries attempted before this result.",
      "type": "integer",
      "minimum": 0
    }
  },
  "examples": [
    {
      "_label": "success: merged",
      "result": "merged",
      "action": "merge",
      "transport": "mcp",
      "sha": "0123456789abcdef0123456789abcdef01234567",
      "blocker": "none",
      "issue_state": "closed",
      "worktree_cleanup": "done",
      "branch_cleanup": "done",
      "authority_verification_source": "description-verified",
      "caller_user_id_verification_source": "fresh-call",
      "cleanup_verified": true,
      "cleanup_failure_reason": "none",
      "override_recorded": false,
      "conflict_type": "none",
      "retry_count": 0
    },
    {
      "_label": "success: auto_merge_queued",
      "result": "auto_merge_queued",
      "action": "auto_merge",
      "transport": "glab-fallback",
      "sha": "1111111111111111111111111111111111111111",
      "blocker": "none",
      "issue_state": "closure_pending",
      "worktree_cleanup": "pending",
      "branch_cleanup": "retained_by_policy",
      "authority_verification_source": "description-verified",
      "caller_user_id_verification_source": "fresh-call",
      "cleanup_verified": "pending",
      "cleanup_failure_reason": "none",
      "override_recorded": false,
      "conflict_type": "none",
      "retry_count": 0
    },
    {
