      "result": "handoff",
      "action": "none",
      "transport": "n/a",
      "sha": "2222222222222222222222222222222222222222",
      "blocker": "none",
      "issue_state": "n/a",
      "worktree_cleanup": "n/a",
      "branch_cleanup": "retained_by_policy",
      "authority_verification_source": "parameter-assumed",
      "caller_user_id_verification_source": "unknown",
      "cleanup_verified": false,
      "cleanup_failure_reason": "none",
      "override_recorded": false,
      "conflict_type": "none",
      "retry_count": 0
    },
